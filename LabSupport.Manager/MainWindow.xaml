<Window x:Class="LabSupport.Manager.MainWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:vm="clr-namespace:LabSupport.Manager.ViewModels"
        xmlns:views="clr-namespace:LabSupport.Manager.Views"
        mc:Ignorable="d"
        Title="{DynamicResource Str_AppTitle}"
        Height="780" Width="1240"
        WindowStartupLocation="CenterScreen"
        Background="{StaticResource BgDark}">

    <Window.DataContext>
        <vm:MainViewModel/>
    </Window.DataContext>

    <Window.Resources>
        <DataTemplate DataType="{x:Type vm:DashboardViewModel}">
            <views:DashboardView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:ScriptViewModel}">
            <views:ScriptView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:RemoteViewModel}">
            <views:RemoteView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:GenerateAgentViewModel}">
            <views:GenerateAgentView/>
        </DataTemplate>
        <DataTemplate DataType="{x:Type vm:SettingsViewModel}">
            <views:SettingsView/>
        </DataTemplate>
    </Window.Resources>

    <Grid>
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="230"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Navigation Sidebar -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0">
            <Grid Margin="16,20,16,16">
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- App Brand Header -->
                <StackPanel Grid.Row="0" Margin="0,0,0,24">
                    <StackPanel Orientation="Horizontal" VerticalAlignment="Center">
                        <Border Background="{StaticResource AccentBlue}" CornerRadius="6" Width="32" Height="32" Margin="0,0,10,0">
                            <TextBlock Text="LS" Foreground="White" FontWeight="Bold" FontSize="15" HorizontalAlignment="Center" VerticalAlignment="Center"/>
                        </Border>
                        <StackPanel VerticalAlignment="Center">
                            <TextBlock Text="LabSupport" FontSize="16" FontWeight="Bold" Foreground="{StaticResource TextPrimary}"/>
                            <TextBlock Text="Lab Management" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                        </StackPanel>
                    </StackPanel>
                </StackPanel>

                <!-- Nav Menu List -->
                <StackPanel Grid.Row="1">
                    <RadioButton Content="{DynamicResource Str_NavDashboard}" IsChecked="True"
                                 Command="{Binding NavigateDashboardCommand}" Style="{StaticResource NavButton}"/>
                    <RadioButton Content="{DynamicResource Str_NavScript}"
                                 Command="{Binding NavigateScriptCommand}" Style="{StaticResource NavButton}"/>
                    <RadioButton Content="{DynamicResource Str_NavRemote}"
                                 Command="{Binding NavigateRemoteCommand}" Style="{StaticResource NavButton}"/>
                    <RadioButton Content="{DynamicResource Str_NavGenerate}"
                                 Command="{Binding NavigateGenerateCommand}" Style="{StaticResource NavButton}"/>
                    <RadioButton Content="{DynamicResource Str_NavSettings}"
                                 Command="{Binding NavigateSettingsCommand}" Style="{StaticResource NavButton}"/>
                </StackPanel>

                <!-- Bottom Server Status -->
                <Border Grid.Row="2" Background="{StaticResource BgCard}" CornerRadius="6" Padding="12,10">
                    <StackPanel>
                        <StackPanel Orientation="Horizontal" Margin="0,0,0,4">
                            <Ellipse Width="8" Height="8" Fill="{StaticResource AccentGreen}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                            <TextBlock Text="HTTP Server" FontSize="11" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}"/>
                        </StackPanel>
                        <TextBlock Text="{Binding ServerStatus}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>
            </Grid>
        </Border>

        <!-- Main View Host Area -->
        <Grid Grid.Column="1">
            <ContentControl Content="{Binding CurrentViewModel}"/>
        </Grid>
    </Grid>
</Window>
