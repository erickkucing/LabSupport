<UserControl x:Class="LabSupport.Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LabSupport.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BgDark}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings Form Card -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0">
            <StackPanel>
                <TextBlock Text="{DynamicResource Str_SettingsTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,18"/>

                <!-- Language Selection -->
                <TextBlock Text="{DynamicResource Str_LangLabel}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton Content="Bahasa Indonesia" IsChecked="{Binding SelectedLanguage, Converter={x:Null}}" Margin="0,0,16,0" Foreground="{StaticResource TextPrimary}"/>
                    <RadioButton Content="English" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <!-- HTTP Port -->
                <TextBlock Text="Manager HTTP Port:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,14">
                    <TextBox Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12"/>
                </Border>

                <!-- Agent Port -->
                <TextBlock Text="Agent Command Port:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,14">
                    <TextBox Text="{Binding AgentPort, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12"/>
                </Border>

                <!-- Heartbeat Interval -->
                <TextBlock Text="Interval Heartbeat (detik):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,14">
                    <TextBox Text="{Binding HeartbeatInterval, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12"/>
                </Border>

                <!-- Database Path -->
                <TextBlock Text="SQLite Database Path:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,20">
                    <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12" IsReadOnly="True"/>
                </Border>

                <!-- Save Button -->
                <Button Content="{DynamicResource Str_BtnSaveSettings}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreen}" FontSize="12"/>
            </StackPanel>
        </Border>

        <!-- Activity Logs Card -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_ActivityLogs}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <Button Grid.Column="1" Content="Refresh" Command="{Binding RefreshLogsCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ActivityLogs}" AutoGenerateColumns="False"
                          Background="Transparent" RowBackground="#162032" AlternatingRowBackground="#1A263C"
                          Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrushColor}"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding TimestampFormatted}" Width="150"/>
                        <DataGridTextColumn Header="Target Host" Binding="{Binding TargetHost}" Width="130"/>
                        <DataGridTextColumn Header="Aksi" Binding="{Binding Action}" Width="110"/>
                        <DataGridTextColumn Header="Hasil / Pesan" Binding="{Binding Result}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
