<UserControl x:Class="LabSupport.Manager.Views.SettingsView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LabSupport.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:SettingsViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BgDark}" Margin="24">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="380"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Settings Form Card -->
        <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,16,0">
            <ScrollViewer VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_SettingsTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,18"/>

                <!-- Language Selection -->
                <TextBlock Text="{DynamicResource Str_LangLabel}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                <StackPanel Orientation="Horizontal" Margin="0,0,0,16">
                    <RadioButton Content="Bahasa Indonesia" IsChecked="{Binding SelectedLanguage, Converter={x:Null}}" Margin="0,0,16,0" Foreground="{StaticResource TextPrimary}"/>
                    <RadioButton Content="English" Foreground="{StaticResource TextPrimary}"/>
                </StackPanel>

                <!-- HTTP Port -->
                <TextBlock Text="Manager HTTP Port:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,14">
                    <TextBox Text="{Binding HttpPort, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12"/>
                </Border>

                <!-- Agent Port -->
                <TextBlock Text="Agent Command Port:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,14">
                    <TextBox Text="{Binding AgentPort, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12"/>
                </Border>

                <!-- Heartbeat Interval -->
                <TextBlock Text="Interval Heartbeat (detik):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,14">
                    <TextBox Text="{Binding HeartbeatInterval, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12"/>
                </Border>

                <!-- Daily Auto-Shutdown Scheduler -->
                <TextBlock Text="⏰ Jadwal Auto-Shutdown Harian:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox Content="Aktifkan Auto-Shutdown Otomatis" IsChecked="{Binding IsDailyShutdownEnabled}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <Grid>
                            <Grid.ColumnDefinitions>
                                <ColumnDefinition Width="Auto"/>
                                <ColumnDefinition Width="*"/>
                            </Grid.ColumnDefinitions>
                            <TextBlock Grid.Column="0" Text="Waktu (HH:mm): " Foreground="{StaticResource TextSecondary}" VerticalAlignment="Center" FontSize="11"/>
                            <TextBox Grid.Column="1" Text="{Binding DailyShutdownTime, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="4,2" FontSize="12" FontWeight="SemiBold"/>
                        </Grid>
                    </StackPanel>
                </Border>

                <!-- App Guard Blacklist -->
                <TextBlock Text="🛡️ Blacklist Aplikasi (App Guard):" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <CheckBox Content="Aktifkan Silent Kill Game/App" IsChecked="{Binding IsAppGuardEnabled}" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,6"/>
                        <TextBlock Text="Nama proses (cth: steam,roblox,discord):" Foreground="{StaticResource TextMuted}" FontSize="10" Margin="0,0,0,4"/>
                        <TextBox Text="{Binding AppGuardBlacklist, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="4,2" FontSize="11" Height="50" TextWrapping="Wrap" AcceptsReturn="True" VerticalScrollBarVisibility="Auto"/>
                    </StackPanel>
                </Border>

                <!-- AI Assistant (9router) Integration -->
                <TextBlock Text="{DynamicResource Str_AiSettingsTitle}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Padding="10,8" Margin="0,0,0,14">
                    <StackPanel>
                        <TextBlock Text="{DynamicResource Str_AiSettingsDesc}" Foreground="{StaticResource TextMuted}" FontSize="10" TextWrapping="Wrap" Margin="0,0,0,8"/>

                        <TextBlock Text="{DynamicResource Str_AiBaseUrl}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="3" Height="28" Margin="0,0,0,8">
                            <TextBox Text="{Binding AiRouterBaseUrl, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="6,4" FontSize="11"/>
                        </Border>

                        <TextBlock Text="{DynamicResource Str_AiApiKey}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="3" Height="28" Margin="0,0,0,8">
                            <TextBox Text="{Binding AiRouterApiKey, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="6,4" FontSize="11"/>
                        </Border>

                        <TextBlock Text="{DynamicResource Str_AiModel}" Foreground="{StaticResource TextSecondary}" FontSize="11" Margin="0,0,0,2"/>
                        <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="3" Height="28" Margin="0,0,0,10">
                            <TextBox Text="{Binding AiRouterModel, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="6,4" FontSize="11"/>
                        </Border>

                        <Button Content="{DynamicResource Str_BtnTestAiConnection}" Command="{Binding TestAiConnectionCommand}" Style="{StaticResource SecondaryButton}" Height="30" FontSize="11" Margin="0,0,0,6"/>
                        <TextBlock Text="{Binding AiConnectionStatus}" Foreground="{StaticResource TextSecondary}" FontSize="11" TextWrapping="Wrap"/>
                    </StackPanel>
                </Border>

                <!-- Database Path -->
                <TextBlock Text="SQLite Database Path:" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,4"/>
                <Border Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Height="32" Margin="0,0,0,20">
                    <TextBox Text="{Binding DatabasePath, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="8,6" FontSize="12" IsReadOnly="True"/>
                </Border>

                <!-- Save Button -->
                <Button Content="{DynamicResource Str_BtnSaveSettings}" Command="{Binding SaveSettingsCommand}" Style="{StaticResource PrimaryButton}" Height="38" Margin="0,0,0,12"/>

                <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource AccentGreen}" FontSize="12"/>
                </StackPanel>
            </ScrollViewer>
        </Border>

        <!-- Activity Logs Card -->
        <Border Grid.Column="1" Style="{StaticResource ModernCard}">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                </Grid.RowDefinitions>

                <Grid Grid.Row="0" Margin="0,0,0,14">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>
                    <TextBlock Text="{DynamicResource Str_ActivityLogs}" FontSize="16" FontWeight="SemiBold" Foreground="{StaticResource TextPrimary}" VerticalAlignment="Center"/>
                    <StackPanel Grid.Column="1" Orientation="Horizontal">
                        <Button Content="{DynamicResource Str_BtnExportLogs}" Command="{Binding ExportLogsCommand}" Style="{StaticResource PrimaryButton}" Padding="8,4" FontSize="11" Margin="0,0,8,0"/>
                        <Button Content="Refresh" Command="{Binding RefreshLogsCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11"/>
                    </StackPanel>
                </Grid>

                <DataGrid Grid.Row="1" ItemsSource="{Binding ActivityLogs}" AutoGenerateColumns="False"
                          Background="Transparent" RowBackground="#162032" AlternatingRowBackground="#1A263C"
                          Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                          GridLinesVisibility="Horizontal" HorizontalGridLinesBrush="{StaticResource BorderBrushColor}"
                          CanUserAddRows="False" IsReadOnly="True" HeadersVisibility="Column">
                    <DataGrid.Columns>
                        <DataGridTextColumn Header="Waktu" Binding="{Binding TimestampFormatted}" Width="150"/>
                        <DataGridTextColumn Header="Target Host" Binding="{Binding TargetHost}" Width="130"/>
                        <DataGridTextColumn Header="Aksi" Binding="{Binding Action}" Width="110"/>
                        <DataGridTextColumn Header="Hasil / Pesan" Binding="{Binding Result}" Width="*"/>
                    </DataGrid.Columns>
                </DataGrid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
