<UserControl x:Class="LabSupport.Manager.Views.RemoteView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LabSupport.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:RemoteViewModel}"
             d:DesignHeight="750" d:DesignWidth="1100">
    <Grid Background="#050811">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
        </Grid.RowDefinitions>

        <!-- Top Primary Control Toolbar -->
        <Border Grid.Row="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="16,10">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Target Info & Connection Toggle -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="{Binding TargetComputer.Hostname, TargetNullValue='(Pilih PC dari Dashboard)'}"
                               FontWeight="Bold" FontSize="14" Foreground="{StaticResource TextPrimary}" Margin="0,0,12,0" VerticalAlignment="Center"/>
                    <Border CornerRadius="4" Padding="6,2" Background="#1E293B" Margin="0,0,12,0" VerticalAlignment="Center">
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextSecondary}" FontSize="11"/>
                    </Border>
                    <Button Content="{DynamicResource Str_BtnConnect}" Command="{Binding ToggleConnectCommand}" Padding="10,6" FontSize="12">
                        <Button.Style>
                            <Style TargetType="Button" BasedOn="{StaticResource PrimaryButton}">
                                <Style.Triggers>
                                    <DataTrigger Binding="{Binding IsConnected}" Value="True">
                                        <Setter Property="Content" Value="{DynamicResource Str_BtnDisconnect}"/>
                                        <Setter Property="Background" Value="#DC2626"/>
                                    </DataTrigger>
                                </Style.Triggers>
                            </Style>
                        </Button.Style>
                    </Button>
                </StackPanel>

                <!-- Middle: Send Message Bar -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" HorizontalAlignment="Center" VerticalAlignment="Center">
                    <TextBlock Text="{DynamicResource Str_SendNotice}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Width="200" Height="30">
                        <TextBox Text="{Binding CustomMessage, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="6,4" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="{DynamicResource Str_BtnSend}" Command="{Binding SendMessageCommand}" Style="{StaticResource SecondaryButton}" Padding="8,5" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>

                <!-- Right: Remote Control Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <Button Content="📁 Kirim Berkas" Command="{Binding SendFileOrFolderCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="0,0,6,0" ToolTip="Kirim file atau folder ke PC siswa dengan streaming performa tinggi"/>
                    <Button Content="{DynamicResource Str_BtnScreenshot}" Command="{Binding SaveScreenshotCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_BtnLock}" Command="{Binding SendLockCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_BtnRestart}" Command="{Binding SendRestartCommand}" Style="{StaticResource SecondaryButton}" Padding="10,6" FontSize="12" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_BtnShutdown}" Command="{Binding SendShutdownCommand}" Style="{StaticResource DangerButton}" Padding="10,6" FontSize="12"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Sub Toolbar: Remote Interaction & Shortcuts -->
        <Border Grid.Row="1" Background="#0c1322" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,0,1" Padding="16,8">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Left: Full Control Toggle & Shortcuts -->
                <StackPanel Grid.Column="0" Orientation="Horizontal" VerticalAlignment="Center">
                    <CheckBox IsChecked="{Binding IsControlEnabled}" Content="Kontrol Mouse &amp; Keyboard" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" VerticalAlignment="Center" Margin="0,0,16,0"/>
                    <TextBlock Text="Shortcut:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,8,0"/>
                    <Button Content="Win + D" Command="{Binding SendShortcutCommand}" CommandParameter="WIN+D" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Alt + F4" Command="{Binding SendShortcutCommand}" CommandParameter="ALT+F4" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Taskmgr" Command="{Binding SendShortcutCommand}" CommandParameter="TASKMGR" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Win + R" Command="{Binding SendShortcutCommand}" CommandParameter="WIN+R" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Enter" Command="{Binding SendShortcutCommand}" CommandParameter="ENTER" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                    <Button Content="Esc" Command="{Binding SendShortcutCommand}" CommandParameter="ESC" Style="{StaticResource SecondaryButton}" Padding="6,3" FontSize="11" Margin="0,0,4,0"/>
                </StackPanel>

                <!-- Right: Remote Typing Bar -->
                <StackPanel Grid.Column="2" Orientation="Horizontal" VerticalAlignment="Center">
                    <TextBlock Text="Kirim Teks:" Foreground="{StaticResource TextMuted}" FontSize="11" VerticalAlignment="Center" Margin="0,0,6,0"/>
                    <Border Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="4" Width="180" Height="28">
                        <TextBox Text="{Binding TypingText, UpdateSourceTrigger=PropertyChanged}" Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0" Padding="4,2" FontSize="11" VerticalAlignment="Center"/>
                    </Border>
                    <Button Content="Ketik di PC" Command="{Binding SendTypingTextCommand}" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="6,0,0,0"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Main Remote Desktop Display Area -->
        <Border Grid.Row="2" Background="#060913" Margin="10" CornerRadius="8" ClipToBounds="True" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1">
            <Grid>
                <!-- Live Screen View with Mouse Event Interactivity -->
                <Image x:Name="ScreenImage"
                       Source="{Binding RemoteScreenSource}"
                       Stretch="Uniform"
                       RenderOptions.BitmapScalingMode="HighQuality"
                       Cursor="Hand"
                       MouseDown="OnScreenMouseDown"
                       MouseWheel="OnScreenMouseWheel"/>

                <!-- Placeholder Overlay when disconnected -->
                <Grid>
                    <Grid.Style>
                        <Style TargetType="Grid">
                            <Setter Property="Visibility" Value="Collapsed"/>
                            <Style.Triggers>
                                <DataTrigger Binding="{Binding RemoteScreenSource}" Value="{x:Null}">
                                    <Setter Property="Visibility" Value="Visible"/>
                                </DataTrigger>
                            </Style.Triggers>
                        </Style>
                    </Grid.Style>
                    <StackPanel HorizontalAlignment="Center" VerticalAlignment="Center">
                        <TextBlock Text="🖥️" FontSize="48" HorizontalAlignment="Center" Margin="0,0,0,12"/>
                        <TextBlock Text="{Binding ConnectionStatus}" Foreground="{StaticResource TextSecondary}" FontSize="15" FontWeight="Medium" HorizontalAlignment="Center"/>
                        <TextBlock Text="Pilih komputer pada tab Dashboard, lalu klik 'Mulai Remote' untuk streaming dan remote kontrol interaktif." Foreground="{StaticResource TextMuted}" FontSize="12" HorizontalAlignment="Center" Margin="0,6,0,0"/>
                    </StackPanel>
                </Grid>
            </Grid>
        </Border>
    </Grid>
</UserControl>
