<UserControl x:Class="LabSupport.Manager.Views.ScriptView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LabSupport.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:ScriptViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BgDark}">
        <Grid.ColumnDefinitions>
            <ColumnDefinition Width="480"/>
            <ColumnDefinition Width="*"/>
        </Grid.ColumnDefinitions>

        <!-- Left Column: Script Editor & Controls -->
        <Border Grid.Column="0" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,0,1,0" Padding="20">
            <Grid>
                <Grid.RowDefinitions>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="Auto"/>
                    <RowDefinition Height="*"/>
                    <RowDefinition Height="Auto"/>
                </Grid.RowDefinitions>

                <!-- Header -->
                <TextBlock Grid.Row="0" Text="{DynamicResource Str_ScriptTitle}" FontSize="18" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" Margin="0,0,0,16"/>

                <!-- Config Options (Type & Target) -->
                <StackPanel Grid.Row="1" Margin="0,0,0,14">
                    <TextBlock Text="{DynamicResource Str_ScriptType}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="PowerShell (.ps1)" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                        <RadioButton Content="Command Prompt (.bat)" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <TextBlock Text="{DynamicResource Str_ScriptTarget}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <StackPanel Orientation="Horizontal" Margin="0,0,0,12">
                        <RadioButton Content="{DynamicResource Str_TargetAllOnline}" IsChecked="True" Foreground="{StaticResource TextPrimary}" Margin="0,0,16,0"/>
                        <RadioButton Content="{DynamicResource Str_TargetSelected}" Foreground="{StaticResource TextPrimary}"/>
                    </StackPanel>

                    <!-- Quick Templates -->
                    <TextBlock Text="{DynamicResource Str_Templates}" Foreground="{StaticResource TextSecondary}" FontSize="12" Margin="0,0,0,6"/>
                    <WrapPanel Orientation="Horizontal">
                        <Button Content="Info Sistem" Command="{Binding SelectTemplateCommand}" CommandParameter="SysInfo" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6"/>
                        <Button Content="Flush DNS" Command="{Binding SelectTemplateCommand}" CommandParameter="FlushDns" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6"/>
                        <Button Content="List Service" Command="{Binding SelectTemplateCommand}" CommandParameter="ListServices" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6"/>
                        <Button Content="Hapus Temp" Command="{Binding SelectTemplateCommand}" CommandParameter="ClearTemp" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6"/>
                        <Button Content="Ping 8.8.8.8" Command="{Binding SelectTemplateCommand}" CommandParameter="PingTest" Style="{StaticResource SecondaryButton}" Padding="8,4" FontSize="11" Margin="0,0,6,6"/>
                    </WrapPanel>
                </StackPanel>

                <!-- Script Editor Box -->
                <Border Grid.Row="3" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Margin="0,0,0,16">
                    <TextBox Text="{Binding ScriptContent, UpdateSourceTrigger=PropertyChanged}"
                             AcceptsReturn="True" AcceptsTab="True"
                             FontFamily="Consolas, Cascadia Code, Courier New" FontSize="12"
                             Foreground="#E2E8F0" Background="Transparent" BorderThickness="0"
                             Padding="12" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Auto"/>
                </Border>

                <!-- Action Buttons -->
                <Grid Grid.Row="4">
                    <Grid.ColumnDefinitions>
                        <ColumnDefinition Width="*"/>
                        <ColumnDefinition Width="Auto"/>
                    </Grid.ColumnDefinitions>

                    <Button Grid.Column="0" Content="{DynamicResource Str_BtnRunScript}" Command="{Binding ExecuteCommand}" Style="{StaticResource PrimaryButton}" Margin="0,0,10,0"/>
                    <Button Grid.Column="1" Content="{DynamicResource Str_BtnClearResults}" Command="{Binding ClearResultsCommand}" Style="{StaticResource SecondaryButton}"/>
                </Grid>
            </Grid>
        </Border>

        <!-- Right Column: Results Stream per PC -->
        <Grid Grid.Column="1" Margin="20">
            <Grid.RowDefinitions>
                <RowDefinition Height="Auto"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!-- Status Header -->
            <Border Grid.Row="0" Style="{StaticResource ModernCard}" Margin="0,0,0,16">
                <TextBlock Text="{Binding StatusText}" Foreground="{StaticResource TextPrimary}" FontWeight="SemiBold" FontSize="13"/>
            </Border>

            <!-- Results List -->
            <ScrollViewer Grid.Row="1" VerticalScrollBarVisibility="Auto">
                <ItemsControl ItemsSource="{Binding Results}">
                    <ItemsControl.ItemTemplate>
                        <DataTemplate>
                            <Border Style="{StaticResource ModernCard}" Margin="0,0,0,12" Padding="14">
                                <StackPanel>
                                    <Grid Margin="0,0,0,8">
                                        <Grid.ColumnDefinitions>
                                            <ColumnDefinition Width="*"/>
                                            <ColumnDefinition Width="Auto"/>
                                        </Grid.ColumnDefinitions>

                                        <StackPanel Grid.Column="0" Orientation="Horizontal">
                                            <TextBlock Text="{Binding Hostname}" FontWeight="Bold" Foreground="{StaticResource TextPrimary}" FontSize="13"/>
                                            <TextBlock Text="{Binding Ip, StringFormat=' ({}{0})'}" Foreground="{StaticResource TextSecondary}" FontSize="12" VerticalAlignment="Center"/>
                                        </StackPanel>

                                        <StackPanel Grid.Column="1" Orientation="Horizontal">
                                            <TextBlock Text="{Binding ExecutionTimeMs, StringFormat='{}{0} ms'}" Foreground="{StaticResource TextMuted}" FontSize="11" Margin="0,0,10,0" VerticalAlignment="Center"/>
                                            <Border CornerRadius="4" Padding="6,2" Background="#1E3A8A">
                                                <TextBlock Text="{Binding Status}" Foreground="White" FontSize="11" FontWeight="SemiBold"/>
                                            </Border>
                                        </StackPanel>
                                    </Grid>

                                    <!-- Output Console Block -->
                                    <Border Background="#090D16" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                        <TextBlock Text="{Binding Output}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#A7F3D0" TextWrapping="Wrap"/>
                                    </Border>

                                    <!-- Error Console Block (if any) -->
                                    <Border Background="#450A0A" CornerRadius="4" Padding="10" Margin="0,4,0,0">
                                        <Border.Style>
                                            <Style TargetType="Border">
                                                <Setter Property="Visibility" Value="Collapsed"/>
                                                <Style.Triggers>
                                                    <DataTrigger Binding="{Binding IsSuccess}" Value="False">
                                                        <Setter Property="Visibility" Value="Visible"/>
                                                    </DataTrigger>
                                                </Style.Triggers>
                                            </Style>
                                        </Border.Style>
                                        <TextBlock Text="{Binding Error}" FontFamily="Consolas, monospace" FontSize="11" Foreground="#FECACA" TextWrapping="Wrap"/>
                                    </Border>
                                </StackPanel>
                            </Border>
                        </DataTemplate>
                    </ItemsControl.ItemTemplate>
                </ItemsControl>
            </ScrollViewer>
        </Grid>
    </Grid>
</UserControl>
