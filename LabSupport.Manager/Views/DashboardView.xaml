<UserControl x:Class="LabSupport.Manager.Views.DashboardView"
             xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
             xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
             xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006" 
             xmlns:d="http://schemas.microsoft.com/expression/blend/2008" 
             xmlns:vm="clr-namespace:LabSupport.Manager.ViewModels"
             mc:Ignorable="d" 
             d:DataContext="{d:DesignInstance vm:DashboardViewModel}"
             d:DesignHeight="700" d:DesignWidth="1000">
    <Grid Background="{StaticResource BgDark}">
        <Grid.RowDefinitions>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="Auto"/>
            <RowDefinition Height="*"/>
            <RowDefinition Height="Auto"/>
        </Grid.RowDefinitions>

        <!-- Metric Summary Cards -->
        <Grid Grid.Row="0" Margin="20,16,20,12">
            <Grid.ColumnDefinitions>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
                <ColumnDefinition Width="*"/>
            </Grid.ColumnDefinitions>

            <!-- Total PCs -->
            <Border Grid.Column="0" Style="{StaticResource ModernCard}" Margin="0,0,10,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_TotalPCs}" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="{Binding TotalCount}" Foreground="{StaticResource TextPrimary}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Online PCs -->
            <Border Grid.Column="1" Style="{StaticResource ModernCard}" Margin="5,0,5,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_OnlinePCs}" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="{Binding OnlineCount}" Foreground="{StaticResource AccentGreen}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>

            <!-- Offline PCs -->
            <Border Grid.Column="2" Style="{StaticResource ModernCard}" Margin="10,0,0,0">
                <StackPanel>
                    <TextBlock Text="{DynamicResource Str_OfflinePCs}" Foreground="{StaticResource TextSecondary}" FontSize="12" FontWeight="Medium"/>
                    <TextBlock Text="{Binding OfflineCount}" Foreground="{StaticResource TextMuted}" FontSize="24" FontWeight="Bold" Margin="0,4,0,0"/>
                </StackPanel>
            </Border>
        </Grid>

        <!-- Toolbar & Filter Bar -->
        <Border Grid.Row="1" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,1" Padding="20,10" Margin="0,0,0,12">
            <Grid>
                <Grid.ColumnDefinitions>
                    <ColumnDefinition Width="Auto"/>
                    <ColumnDefinition Width="*"/>
                    <ColumnDefinition Width="Auto"/>
                </Grid.ColumnDefinitions>

                <!-- Search Input -->
                <Border Grid.Column="0" Background="{StaticResource BgCard}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="1" CornerRadius="6" Width="260" Height="34">
                    <Grid>
                        <TextBox Text="{Binding SearchText, UpdateSourceTrigger=PropertyChanged}"
                                 Background="Transparent" Foreground="{StaticResource TextPrimary}" BorderThickness="0"
                                 Padding="10,7" VerticalAlignment="Center" FontSize="12"/>
                    </Grid>
                </Border>

                <!-- Filter Pills -->
                <StackPanel Grid.Column="1" Orientation="Horizontal" Margin="16,0,0,0" VerticalAlignment="Center">
                    <Button Content="{DynamicResource Str_SelectAll}" Command="{Binding SelectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_DeselectAll}" Command="{Binding DeselectAllCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,12,0"/>
                    <Button Content="{DynamicResource Str_FilterAll}" Command="{Binding RefreshCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                </StackPanel>

                <!-- Batch Actions -->
                <StackPanel Grid.Column="2" Orientation="Horizontal">
                    <Button Content="{DynamicResource Str_BtnWake}" Command="{Binding WakeSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_BtnLock}" Command="{Binding LockSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_BtnRestart}" Command="{Binding RestartSelectedCommand}" Style="{StaticResource SecondaryButton}" Margin="0,0,6,0"/>
                    <Button Content="{DynamicResource Str_BtnShutdown}" Command="{Binding ShutdownSelectedCommand}" Style="{StaticResource DangerButton}"/>
                </StackPanel>
            </Grid>
        </Border>

        <!-- Computers Tile Grid -->
        <ScrollViewer Grid.Row="2" VerticalScrollBarVisibility="Auto" HorizontalScrollBarVisibility="Disabled" Padding="16,0">
            <ItemsControl ItemsSource="{Binding FilteredComputers}">
                <ItemsControl.ItemsPanel>
                    <ItemsPanelTemplate>
                        <WrapPanel Orientation="Horizontal" ItemWidth="230" ItemHeight="260"/>
                    </ItemsPanelTemplate>
                </ItemsControl.ItemsPanel>
                <ItemsControl.ItemTemplate>
                    <DataTemplate>
                        <Border Margin="6" Style="{StaticResource ModernCard}" Padding="10">
                            <Grid>
                                <Grid.RowDefinitions>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="110"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                    <RowDefinition Height="Auto"/>
                                </Grid.RowDefinitions>

                                <!-- Header: Checkbox + Hostname + Status Dot -->
                                <Grid Grid.Row="0" Margin="0,0,0,6">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="Auto"/>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="Auto"/>
                                    </Grid.ColumnDefinitions>

                                    <CheckBox Grid.Column="0" IsChecked="{Binding IsSelected}" VerticalAlignment="Center" Margin="0,0,6,0"/>
                                    <TextBlock Grid.Column="1" Text="{Binding Hostname}" FontWeight="Bold" FontSize="13" Foreground="{StaticResource TextPrimary}" TextTrimming="CharacterEllipsis" VerticalAlignment="Center"/>
                                    <Ellipse Grid.Column="2" Width="10" Height="10" Fill="{Binding StatusBrush}" VerticalAlignment="Center" Margin="4,0,0,0"/>
                                </Grid>

                                <!-- Thumbnail Screen Preview -->
                                <Border Grid.Row="1" Background="#0F172A" CornerRadius="4" ClipToBounds="True" Margin="0,0,0,8">
                                    <Grid>
                                        <Image Source="{Binding ThumbnailSource}" Stretch="UniformToFill" RenderOptions.BitmapScalingMode="HighQuality"/>
                                        <TextBlock Text="No Preview" Foreground="{StaticResource TextMuted}" FontSize="11" HorizontalAlignment="Center" VerticalAlignment="Center">
                                            <TextBlock.Style>
                                                <Style TargetType="TextBlock">
                                                    <Setter Property="Visibility" Value="Collapsed"/>
                                                    <Style.Triggers>
                                                        <DataTrigger Binding="{Binding ThumbnailSource}" Value="{x:Null}">
                                                            <Setter Property="Visibility" Value="Visible"/>
                                                        </DataTrigger>
                                                    </Style.Triggers>
                                                </Style>
                                            </TextBlock.Style>
                                        </TextBlock>
                                    </Grid>
                                </Border>

                                <!-- IP & MAC Details -->
                                <StackPanel Grid.Row="2" Margin="0,0,0,6">
                                    <TextBlock Text="{Binding IpAddress}" FontSize="11" Foreground="{StaticResource TextSecondary}"/>
                                    <TextBlock Text="{Binding MacAddress}" FontSize="10" Foreground="{StaticResource TextMuted}" TextTrimming="CharacterEllipsis"/>
                                </StackPanel>

                                <!-- CPU / RAM Mini Bars -->
                                <Grid Grid.Row="3" Margin="0,0,0,8">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <StackPanel Grid.Column="0" Margin="0,0,4,0">
                                        <TextBlock Text="{Binding CpuFormatted}" FontSize="10" Foreground="{StaticResource TextSecondary}"/>
                                        <ProgressBar Value="{Binding CpuUsage}" Maximum="100" Height="4" Background="#334155" Foreground="{StaticResource AccentBlue}" BorderThickness="0"/>
                                    </StackPanel>
                                    <StackPanel Grid.Column="1" Margin="4,0,0,0">
                                        <TextBlock Text="{Binding RamFormatted}" FontSize="10" Foreground="{StaticResource TextSecondary}" TextTrimming="CharacterEllipsis"/>
                                        <ProgressBar Value="{Binding RamPercent}" Maximum="100" Height="4" Background="#334155" Foreground="{StaticResource AccentGreen}" BorderThickness="0"/>
                                    </StackPanel>
                                </Grid>

                                <!-- Quick Actions per PC -->
                                <Grid Grid.Row="4">
                                    <Grid.ColumnDefinitions>
                                        <ColumnDefinition Width="*"/>
                                        <ColumnDefinition Width="*"/>
                                    </Grid.ColumnDefinitions>
                                    <Button Grid.Column="0" Content="Remote"
                                            Command="{Binding DataContext.OpenRemoteCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource PrimaryButton}" Padding="4,4" Margin="0,0,3,0" FontSize="11"/>
                                    <Button Grid.Column="1" Content="Script"
                                            Command="{Binding DataContext.OpenScriptCommand, RelativeSource={RelativeSource AncestorType=UserControl}}"
                                            CommandParameter="{Binding}"
                                            Style="{StaticResource SecondaryButton}" Padding="4,4" Margin="3,0,0,0" FontSize="11"/>
                                </Grid>
                            </Grid>
                        </Border>
                    </DataTemplate>
                </ItemsControl.ItemTemplate>
            </ItemsControl>
        </ScrollViewer>

        <!-- Bottom Status Bar -->
        <Border Grid.Row="3" Background="{StaticResource BgSidebar}" BorderBrush="{StaticResource BorderBrushColor}" BorderThickness="0,1,0,0" Padding="20,6">
            <TextBlock Text="{Binding StatusMessage}" Foreground="{StaticResource TextSecondary}" FontSize="12"/>
        </Border>
    </Grid>
</UserControl>
